server:
  port: {{coordinator.port}}

atmosphere:
{{#isSingleJar}}
  packages: {{allPackages}}
{{/isSingleJar}}
{{^isSingleJar}}
  packages: {{agent.packageName}}
{{/isSingleJar}}
{{#isRemoteFleet}}
  # Fleet agents are called over A2A (JSON-RPC over HTTP). The coordinator
  # reads atmosphere.fleet.agents.<name>.url; an AGENT_<NAME>_URL environment
  # variable overrides it (docker-compose sets one per service).
  init-params:
{{#agents}}
{{#isSingleJar}}
    atmosphere.fleet.agents.{{name}}.url: http://localhost:${server.port}/atmosphere/agent/{{name}}/a2a
{{/isSingleJar}}
{{^isSingleJar}}
    atmosphere.fleet.agents.{{name}}.url: http://localhost:{{port}}/atmosphere/agent/{{name}}/a2a
{{/isSingleJar}}
{{/agents}}
{{/isRemoteFleet}}

{{#isBuiltin}}
atmosphere.ai:
  provider: openai
  api-key: ${LLM_API_KEY:}
  model: ${LLM_MODEL:gpt-4o}
{{/isBuiltin}}
{{#isLangchain4j}}
langchain4j:
  open-ai:
    streaming-chat-model:
      api-key: ${LLM_API_KEY:}
      model-name: ${LLM_MODEL:gpt-4o}
{{/isLangchain4j}}
{{#isSpringAi}}
spring:
  ai:
    openai:
      api-key: ${LLM_API_KEY:}
      chat:
        options:
          model: ${LLM_MODEL:gpt-4o}
{{/isSpringAi}}

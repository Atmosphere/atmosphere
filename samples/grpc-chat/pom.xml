<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <parent>
        <groupId>org.atmosphere</groupId>
        <artifactId>atmosphere-project</artifactId>
        <version>4.0.74-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.atmosphere.samples</groupId>
    <artifactId>atmosphere-grpc-chat</artifactId>
    <packaging>jar</packaging>
    <name>atmosphere-grpc-chat</name>
    <description>Atmosphere gRPC transport chat sample with Connect-Web frontend</description>

    <dependencies>
        <dependency>
            <groupId>org.atmosphere</groupId>
            <artifactId>atmosphere-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>org.atmosphere</groupId>
            <artifactId>atmosphere-grpc</artifactId>
        </dependency>

        <!-- Embedded Jetty for HTTP server (Connect protocol + static frontend) -->
        <dependency>
            <groupId>org.eclipse.jetty.ee10</groupId>
            <artifactId>jetty-ee10-servlet</artifactId>
            <version>${jetty-version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
            <version>${jetty-version}</version>
        </dependency>

        <!-- Protobuf JSON format for Connect protocol JSON mode -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java-util</artifactId>
            <version>${protobuf.version}</version>
        </dependency>

        <!-- Both at compile scope on purpose: the parent pom manages logback at test
             scope, so logback-core reached the run classpath only transitively and was
             dropped. LogbackServiceProvider then failed to load, SLF4J fell back to its
             no-operation logger, and the server printed nothing. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
            <version>${logback-version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback-version}</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- exec:exec defaults: override with -Dhttp.port / -Dgrpc.port, and run the CLI
             client with -Dexec.mainClass=org.atmosphere.samples.grpc.GrpcChatClient. -->
        <exec.mainClass>org.atmosphere.samples.grpc.GrpcChatServer</exec.mainClass>
        <http.port>8080</http.port>
        <grpc.port>9090</grpc.port>
    </properties>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>org.atmosphere.samples.grpc.GrpcChatServer</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

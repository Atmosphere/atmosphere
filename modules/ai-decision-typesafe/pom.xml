<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <parent>
        <groupId>org.atmosphere</groupId>
        <artifactId>atmosphere-project</artifactId>
        <version>4.0.73-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>atmosphere-ai-decision-typesafe</artifactId>
    <packaging>jar</packaging>
    <name>atmosphere-ai-decision-typesafe</name>
    <description>DecisionModel adapter for the TypeSafe (typesafe.ai) System One decision API</description>
    <url>https://github.com/Atmosphere/atmosphere</url>

    <properties>
        <atmosphere.module.name>org.atmosphere.ai.decision.typesafe</atmosphere.module.name>
    </properties>

    <dependencies>
        <!--
          The DecisionModel SPI, Jackson 3 (tools.jackson) and SLF4J all come
          from atmosphere-ai. The HTTP client is the JDK's java.net.http, so
          the adapter adds no third-party runtime dependency.
        -->
        <dependency>
            <groupId>org.atmosphere</groupId>
            <artifactId>atmosphere-ai</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback-version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
